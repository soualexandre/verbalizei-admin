# Base URL da API NestJS (inclui o prefixo /api)
# A porta vem de PORT no .env do elovoz-api (atualmente 3012; 3010 está ocupada por um serviço Python)
NEXT_PUBLIC_API_URL=http://localhost:3012/api
# App de quem treina: o link de convite das empresas aponta para lá
NEXT_PUBLIC_APP_URL=https://app.verbalizei.com.br
