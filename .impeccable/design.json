  "components": [
    {
      "name": "Faixa de tela (PageHero)",
      "kind": "custom",
      "refersTo": "page-hero",
      "description": "Abre toda tela: título, descrição, ações e totalizadores sobre o azul, com fio de lima na base.",
      "html": "<section class=\"ds-hero\"><div class=\"ds-hero-top\"><div><h1 class=\"ds-hero-title\">Visão geral</h1><p class=\"ds-hero-desc\">26/09 a 25/10, comparado aos 30 dias anteriores · base de 132 pessoas.</p></div><div class=\"ds-hero-tabs\"><button class=\"ds-hero-tab ds-on\">7 dias</button><button class=\"ds-hero-tab\">30 dias</button><button class=\"ds-hero-tab\">90 dias</button></div></div><span class=\"ds-hero-spark\"></span></section>",
      "css": ".ds-hero{position:relative;overflow:hidden;border-radius:28px;padding:32px;color:#fff;background:linear-gradient(135deg,#0063de 0%,#0063de 55%,#003f8f 100%);box-shadow:0 12px 32px -18px rgb(0 63 143/.55);font-family:'DM Sans',sans-serif}.ds-hero-top{display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:flex-start}.ds-hero-title{font-family: var(--font-raleway), 'Raleway', 'DM Sans', sans-serif;font-size:2rem;font-weight:800;line-height:1.25;letter-spacing:-.025em;margin:0}.ds-hero-desc{font-size:15px;line-height:1.6;color:rgb(255 255 255/.9);margin:6px 0 0}.ds-hero-tabs{display:inline-flex;gap:2px;padding:4px;border-radius:12px;background:rgb(255 255 255/.14)}.ds-hero-tab{height:32px;padding:0 12px;border:0;border-radius:8px;background:transparent;color:rgb(255 255 255/.92);font:500 14px 'DM Sans',sans-serif;cursor:pointer}.ds-hero-tab:hover{background:rgb(255 255 255/.1)}.ds-hero-tab:focus-visible{outline:2px solid #fff;outline-offset:2px}.ds-hero-tab.ds-on{background:#fff;color:#004ba6;font-weight:600}.ds-hero-spark{position:absolute;left:0;right:0;bottom:0;height:4px;background:#cfdc3e}"
    },
    {
      "name": "Totalizador (HeroStat)",
      "kind": "card",
      "refersTo": "hero-stat",
      "description": "Um número na faixa: rótulo de 2 linhas, número Raleway 800, variação embaixo, nota curta.",
      "html": "<div class=\"ds-stat-wrap\"><div class=\"ds-stat\" title=\"Pessoas que treinaram ao menos uma vez no período.\"><p class=\"ds-stat-label\">Pessoas que treinaram</p><p class=\"ds-stat-value\">41</p><span class=\"ds-trend ds-up\">↗ +24%</span><p class=\"ds-stat-note\">31,1% da base · 30 dias antes: 33</p></div><div class=\"ds-stat\"><p class=\"ds-stat-label\">Novos cadastros</p><p class=\"ds-stat-value\">48</p><span class=\"ds-trend ds-down\">↘ −12%</span><p class=\"ds-stat-note\">22 já treinaram (46%)</p></div></div>",
      "css": ".ds-stat-wrap{display:grid;grid-template-columns:repeat(2,minmax(0,200px));gap:12px;padding:24px;background:#0063de;border-radius:28px;font-family:'DM Sans',sans-serif}.ds-stat{display:flex;flex-direction:column;border-radius:16px;padding:16px;background:rgb(0 40 100/.32);box-shadow:inset 0 0 0 1px rgb(255 255 255/.1);color:#fff;transition:background .15s}.ds-stat:hover{background:rgb(0 40 100/.42)}.ds-stat-label{margin:0;min-height:2.75em;font-size:13px;font-weight:500;line-height:1.375;color:rgb(255 255 255/.9)}.ds-stat-value{margin:4px 0 0;font-family: var(--font-raleway), 'Raleway', 'DM Sans', sans-serif;font-size:2rem;font-weight:800;line-height:1;letter-spacing:-.025em;font-variant-numeric:tabular-nums}.ds-trend{margin-top:8px;width:fit-content;border-radius:9999px;padding:2px 6px;font-size:11px;font-weight:700}.ds-up{background:#81a641;color:#14200a}.ds-down{background:#cfdc3e;color:#2f3604}.ds-stat-note{margin:6px 0 0;font-size:12px;line-height:1.375;color:rgb(255 255 255/.9)}"
    },
    {
      "name": "Botão principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ação principal fora da faixa.",
      "html": "<button class=\"ds-btn-primary\">Salvar limite</button>",
      "css": ".ds-btn-primary{height:40px;padding:0 16px;border:0;border-radius:12px;background:#0063de;color:#fff;font:700 14px 'DM Sans',sans-serif;box-shadow:0 6px 16px -8px rgba(12,76,174,.6);cursor:pointer;transition:background .15s,transform .15s}.ds-btn-primary:hover{background:#0a3d8f}.ds-btn-primary:active{transform:scale(.98)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px rgb(0 99 222/.5)}"
    },
    {
      "name": "Botão de contorno",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Ação secundária e o Tentar de novo.",
