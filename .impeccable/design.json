      "css": ".ds-nav{width:232px;padding:12px;background:#fff;font-family:'DM Sans',sans-serif}.ds-nav-group{margin:0 0 4px;padding:0 12px;height:32px;line-height:32px;font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#586a82}.ds-nav-item{display:flex;align-items:center;gap:12px;height:44px;padding:0 12px;border-radius:12px;color:#586a82;font-size:15px;font-weight:500;text-decoration:none;transition:background .15s,color .15s,transform .15s}.ds-nav-item svg{color:rgb(88 106 130/.8)}.ds-nav-item:hover{background:rgb(0 0 0/.04);color:#0b1b33}.ds-nav-item:active{transform:scale(.98)}.ds-nav-item:focus-visible{outline:none;box-shadow:0 0 0 2px #fff,0 0 0 4px #0063de}.ds-nav-item.ds-active{background:#eef4fd;color:#0b1b33;font-weight:600}.ds-nav-item.ds-active svg{color:#0063de}"
