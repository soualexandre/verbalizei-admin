      "css": ".ds-btn-outline{height:36px;padding:0 12px;border:1px solid #e2e8f1;border-radius:12px;background:#fff;color:#586a82;font:600 14px 'DM Sans',sans-serif;cursor:pointer;transition:border-color .15s,color .15s,transform .15s}.ds-btn-outline:hover{border-color:#94a3b8;color:#0b1b33}.ds-btn-outline:active{transform:scale(.98)}.ds-btn-outline:focus-visible{outline:none;box-shadow:0 0 0 3px rgb(0 99 222/.5)}"
    },
    {
